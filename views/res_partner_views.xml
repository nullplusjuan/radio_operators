<odoo>

    <record id="view_partner_form_radio_operator" model="ir.ui.view">
        <field name="name">res.partner.form.radio.operator</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="action"
                    name="%(action_radio_callsign)d"
                    icon="fa-broadcast-tower"
                    context="{'default_partner_id': id}"
                    domain="[('partner_id', '=', id)]"
                    invisible="radio_callsign_count == 0"
                >
                    <field name="radio_callsign_count" widget="statinfo" string="Callsigns"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="primary_callsign" readonly="1" placeholder="Primary radio callsign"/>
                <field name="radio_operator" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="Radio Callsigns" name="radio_callsigns">
                    <field name="radio_callsign_ids" context="{'default_partner_id': id}">
                        <list editable="bottom"
                              decoration-danger="status == 'expired'"
                              decoration-muted="status == 'inactive'">
                            <field name="callsign"/>
                            <field name="callsign_type"/>
                            <field name="issuing_organization_id"/>
                            <field name="issue_date" optional="hide"/>
                            <field name="expires" optional="hide"/>
                            <field name="expiry_date"/>
                            <field name="status" readonly="1"/>
                            <field name="is_primary"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="active" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_res_partner_filter_radio_operator" model="ir.ui.view">
        <field name="name">res.partner.search.radio.operator</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">
                <field name="primary_callsign"/>
                <filter
                    name="radio_operators"
                    string="Radio Operators"
                    domain="[('radio_operator', '=', True)]"
                />
            </xpath>

        </field>
    </record>

    <record id="view_partner_tree_radio_operator" model="ir.ui.view">
        <field name="name">res.partner.list.radio.operator</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="primary_callsign" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
