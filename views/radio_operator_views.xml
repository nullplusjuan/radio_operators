<odoo>

    <!-- Issuing Organizations -->

    <record id="view_radio_organization_list" model="ir.ui.view">
        <field name="name">radio.organization.list</field>
        <field name="model">radio.organization</field>
        <field name="arch" type="xml">
            <list string="Issuing Organizations">
                <field name="complete_name"/>
                <field name="code"/>
                <field name="organization_type"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_radio_organization_form" model="ir.ui.view">
        <field name="name">radio.organization.form</field>
        <field name="model">radio.organization</field>
        <field name="arch" type="xml">
            <form string="Issuing Organization">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="organization_type"/>
                            <field name="parent_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="complete_name" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Sub-Organizations">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="organization_type"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_radio_organization_search" model="ir.ui.view">
        <field name="name">radio.organization.search</field>
        <field name="model">radio.organization</field>
        <field name="arch" type="xml">
            <search string="Search Issuing Organizations">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <filter name="teams" string="Teams" domain="[('organization_type', '=', 'team')]"/>
                <filter name="national" string="National Organizations" domain="[('organization_type', '=', 'national')]"/>
                <filter name="regulators" string="Regulators" domain="[('organization_type', '=', 'regulator')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'organization_type'}"/>
                    <filter name="group_parent" string="Parent Organization" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_radio_organization" model="ir.actions.act_window">
        <field name="name">Issuing Organizations</field>
        <field name="res_model">radio.organization</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_radio_organization_search"/>
    </record>

    <!-- Callsigns -->

    <record id="view_radio_callsign_list" model="ir.ui.view">
        <field name="name">radio.callsign.list</field>
        <field name="model">radio.callsign</field>
        <field name="arch" type="xml">
            <list string="Radio Callsigns"
                  decoration-danger="status == 'expired'"
                  decoration-muted="status == 'inactive'">
                <field name="callsign"/>
                <field name="partner_id"/>
                <field name="callsign_type"/>
                <field name="issuing_organization_id"/>
                <field name="issue_date" optional="hide"/>
                <field name="expires" optional="hide"/>
                <field name="expiry_date"/>
                <field name="status"/>
                <field name="is_primary"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_radio_callsign_form" model="ir.ui.view">
        <field name="name">radio.callsign.form</field>
        <field name="model">radio.callsign</field>
        <field name="arch" type="xml">
            <form string="Radio Callsign">
                <sheet>
                    <div class="oe_title">
                        <label for="callsign"/>
                        <h1>
                            <field name="callsign" placeholder="e.g. R615"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="callsign_type"/>
                            <field name="issuing_organization_id"/>
                            <field name="is_primary"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expires"/>
                            <field name="expiry_date" invisible="not expires" required="expires"/>
                            <field name="status" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>

                    <group>
                        <field name="notes" placeholder="License number, restrictions, historical notes, etc."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_radio_callsign_search" model="ir.ui.view">
        <field name="name">radio.callsign.search</field>
        <field name="model">radio.callsign</field>
        <field name="arch" type="xml">
            <search string="Search Radio Callsigns">
                <field name="callsign"/>
                <field name="partner_id"/>
                <field name="issuing_organization_id"/>
                <field name="tag_ids"/>

                <filter name="active_callsigns" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="expired_callsigns" string="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="react_callsigns" string="REACT" domain="[('callsign_type', '=', 'react')]"/>
                <filter name="amateur_callsigns" string="Amateur / Ham" domain="[('callsign_type', '=', 'amateur')]"/>
                <filter name="primary_callsigns" string="Primary" domain="[('is_primary', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'callsign_type'}"/>
                    <filter name="group_issuer" string="Issued By" context="{'group_by': 'issuing_organization_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_radio_callsign" model="ir.actions.act_window">
        <field name="name">Radio Callsigns</field>
        <field name="res_model">radio.callsign</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_radio_callsign_search"/>
        <field name="context">{'search_default_active_callsigns': 1}</field>
    </record>

    <menuitem
        id="menu_radio_operators_root"
        name="Radio Operators"
        sequence="80"
        web_icon="radio_operators,static/description/icon.png"
    />

    <menuitem
        id="menu_radio_callsigns"
        name="Callsigns"
        parent="menu_radio_operators_root"
        action="action_radio_callsign"
        sequence="10"
    />

    <menuitem
        id="menu_radio_organizations"
        name="Issuing Organizations"
        parent="menu_radio_operators_root"
        action="action_radio_organization"
        sequence="20"
    />

</odoo>
